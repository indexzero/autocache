{
  "name": "@autocache/waybackify",
  "version": "0.0.0",
  "description": "Transform dead links into Internet Archive Wayback Machine permalinks",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./audit.js": "./audit.js",
    "./backfill.js": "./backfill.js",
    "./beacons.js": "./beacons.js",
    "./bucket-batch.js": "./bucket-batch.js",
    "./cache.js": "./cache.js",
    "./fsck.js": "./fsck.js",
    "./interstitial.js": "./interstitial.js",
    "./key.js": "./key.js",
    "./ledger.js": "./ledger.js",
    "./manifest.js": "./manifest.js",
    "./remaster.js": "./remaster.js",
    "./requisites.js": "./requisites.js",
    "./rewrite.js": "./rewrite.js",
    "./strip.js": "./strip.js",
    "./universe.js": "./universe.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test ./test/*.test.js",
    "test:live": "WAYBACK_LIVE=1 node --test ./test/*.test.js"
  },
  "keywords": [
    "wayback",
    "internet-archive",
    "links",
    "dead-links"
  ],
  "author": "Charlie Robbins <npm@charlie.dev>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indexzero/autocache.git",
    "directory": "src/waybackify"
  },
  "dependencies": {
    "impit": "^0.14.1"
  }
}
