{
  "name": "waybackify",
  "version": "0.0.0",
  "description": "Transform dead links into Internet Archive Wayback Machine permalinks",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test ./test/*.test.js",
    "test:live": "WAYBACK_LIVE=1 node --test ./test/*.test.js"
  },
  "keywords": [
    "wayback",
    "internet-archive",
    "links",
    "dead-links"
  ],
  "author": "Charlie Robbins <npm@charlie.dev>",
  "license": "MIT",
  "dependencies": {
    "impit": "^0.14.1"
  }
}